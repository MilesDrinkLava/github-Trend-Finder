{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Trend & Finder",
  "version": "2.0.0-alpha.3",
  "identifier": "com.ghfinder.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitHub Trend & Finder · V2.0 Alpha 3",
        "width": 1040,
        "height": 800,
        "minWidth": 800,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "useLocalToolsDir": true
  }
}
